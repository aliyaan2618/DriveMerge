From 8a20d00ac6a940cea2939972db90e087a56ec402 Mon Sep 17 00:00:00 2001
From: Serag Ahmed <serag.science2011@gmail.com>
Date: Tue, 17 Nov 2026 14:35:39 +0300
Subject: [PATCH 2/9] union: fix overwriting a file only updating one upstream
 - fixes #10364

When a file existed on more than one upstream of a union, overwriting
it with copy or sync (without --inplace) only updated one of the
copies.

Rclone uploaded the new data to a temporary .partial name and then
renamed it into place. As the temporary name was a new file, the union
placed it with the create policy (a single upstream with the default
epmfs, and never one tagged :nc) and the rename only replaced the file
on that upstream. The other upstreams kept the old data, which the
union could then return when reading the file. With a single writable
upstream tagged :nc the upload failed with "permission denied".

The union now only advertises PartialUploads when the create and
action policies can only pick the same upstream, that is when it has
a single writable upstream which isn't tagged :nc. Otherwise rclone
uploads to the final name, as it does with --inplace, which updates
the file on every upstream picked by the action policy. This means
uploads to such unions are no longer atomic, the same as with
--inplace.

(cherry picked from commit 723690a6b6b014395907f842579fb435cc05cd78)
---
 backend/union/union.go               | 16 ++++++++
 backend/union/union_internal_test.go | 57 ++++++++++++++++++++++++++++
 docs/content/union.md                |  5 +++
 docs/data/backends/union.yaml        |  1 -
 4 files changed, 78 insertions(+), 1 deletion(-)

diff --git a/backend/union/union.go b/backend/union/union.go
index 1cb0942da..77fedd15f 100644
--- a/backend/union/union.go
+++ b/backend/union/union.go
@@ -1007,6 +1007,22 @@ func NewFs(ctx context.Context, name, root string, m configmap.Mapper) (fs.Fs, e
 	// If any of upstreams are SlowHash, propagate it
 	features.SlowHash = slowHash
 
+	// Partial uploads are created with the create policy then renamed
+	// on that upstream only, so only use them when the create and
+	// action policies can only pick the same single upstream.
+	writable, creatable := 0, 0
+	for _, u := range f.upstreams {
+		if u.IsWritable() {
+			writable++
+		}
+		if u.IsCreatable() {
+			creatable++
+		}
+	}
+	if writable > 1 || creatable != writable {
+		features.PartialUploads = false
+	}
+
 	// Enable ListR when upstreams either support ListR or is local
 	// But not when all upstreams are local
 	if features.ListR == nil {
